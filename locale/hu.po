msgctxt "field:purchase.line,product_template:"
msgid "Product Has packages"
msgstr "A terméknek vannak csomagolásai"

#, python-format
msgctxt "model:ir.message,text:msg_package_quantity"
msgid ""
"The quantity \"%(qty)s\" of product \"%(product)s\" is not a multiple of "
"it\\'s package \"%(package)s\" quantity \"%(package_qty)s\"."
msgstr ""
"A(z) „%(product)s” termék „%(qty)s” mennyisége nem többszöröse a(z) "
"„%(package)s” csomagolás „%(package_qty)s” mennyiségének."

#, python-format
msgctxt "model:ir.message,text:msg_package_required"
msgid ""
"Purchase configuration requires packages on lines. Please assign a package "
"to line \"%(line)s\" and try again."
msgstr ""
"A beszerzési beállítások szerint a tételekhez csomagolás szükséges. "
"Rendeljen csomagolást a(z) „%(line)s” tételhez, majd próbálja újra."

msgctxt "field:product.template,default_purchase_package:"
