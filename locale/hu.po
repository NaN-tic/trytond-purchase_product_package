msgid "Package Quantity"
msgstr "Csomagolási mennyiség"

msgctxt "field:purchase.configuration,package_required:"
msgid "Package Required"
msgstr "Csomagolás kötelező"

msgctxt "field:purchase.line,product_package:"
msgid "Package"
