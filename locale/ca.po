msgctxt "model:ir.message,text:msg_package_quantity"
msgid ""
"The quantity \"%(qty)s\" of product \"%(product)s\" is not a multiple of "
"it\\'s package \"%(package)s\" quantity \"%(package_qty)s\"."
msgstr ""
"La quantitat \"%(qty)s\" del producte \"%(product)s\" no és un múltiple de la quantitat "
"del seu paquet \"%(package)s\" (\"%(package_qty)s\")."

msgctxt "model:ir.message,text:msg_package_required"
msgid "Purchase configuration requires packages on lines. Please assign a package to line \"%(line)s\" and try again."
msgstr "La configuració de compres estableix que les línies han d'utilitzar obligatòriament paquets. Assigneu un paquet a la línia \"%(line)s\" i torneu-ho a provar."

