msgctxt "field:purchase.line,product_template:"
msgid "Product Has packages"
msgstr "El producto tiene paquetes"

msgctxt "model:ir.message,text:msg_package_quantity"
msgid ""
"The quantity \"%(qty)s\" of product \"%(product)s\" is not a multiple of "
"it\\'s package \"%(package)s\" quantity \"%(package_qty)s\"."
msgstr ""
"La cantidad \"%(qty)s\" del producto \"%(product)s\" no es un multiple de la"
" cantidad del paquete \"%(package)s\" (\"%(package_qty)s\")."

msgctxt "model:ir.message,text:msg_package_required"
msgid "Purchase configuration requires packages on lines. Please assign a package to line \"%(line)s\" and try again."
msgstr "La configuración de compras establece que las líneas deben usar obligatoriamente paquetes. Asigne un paquete a la línea \"%(line)s\" e inténtelo de nuevo."

