#, python-format
msgctxt "model:ir.message,text:msg_package_quantity"
msgid ""
"The quantity \"%(qty)s\" of product \"%(product)s\" is not a multiple of "
"it\\'s package \"%(package)s\" quantity \"%(package_qty)s\"."
msgstr "产品“%(product)s”的数量“%(qty)s”不是其包装“%(package)s”数量“%(package_qty)s”的整数倍。"

#, python-format
msgctxt "model:ir.message,text:msg_package_required"
msgid ""
"Purchase configuration requires packages on lines. Please assign a package "
"to line \"%(line)s\" and try again."
msgstr "采购配置要求明细使用包装。请为明细“%(line)s”分配包装后重试。"

