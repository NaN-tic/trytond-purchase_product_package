msgctxt "field:purchase.line,package_quantity:"
msgid "Package Quantity"
msgstr "បរិមាណក្នុងកញ្ចប់"

msgctxt "field:purchase.configuration,package_required:"
msgid "Package Required"
msgstr "តម្រូវឱ្យមានកញ្ចប់"

msgctxt "field:purchase.line,product_package:"
msgid "Package"
msgstr "កញ្ចប់"

msgctxt "field:purchase.line,product_template:"
msgid "Product Has packages"
msgstr "ផលិតផលមានកញ្ចប់"

#, python-format
msgctxt "model:ir.message,text:msg_package_quantity"
msgid ""
"The quantity \"%(qty)s\" of product \"%(product)s\" is not a multiple of "
"it\\'s package \"%(package)s\" quantity \"%(package_qty)s\"."
msgstr ""
"បរិមាណ «%(qty)s» របស់ផលិតផល «%(product)s» មិនមែនជាពហុគុណនៃបរិមាណ "
"«%(package_qty)s» ក្នុងកញ្ចប់ «%(package)s» ទេ។"

#, python-format
msgctxt "model:ir.message,text:msg_package_required"
msgid ""
"Purchase configuration requires packages on lines. Please assign a package to"
" line \"%(line)s\" and try again."
msgstr ""
"ការកំណត់ការទិញតម្រូវឱ្យមានកញ្ចប់ក្នុងបន្ទាត់។ សូមកំណត់កញ្ចប់សម្រាប់បន្ទាត់ "
"«%(line)s» ហើយព្យាយាមម្តងទៀត។"

msgctxt "field:product.template,default_purchase_package:"
